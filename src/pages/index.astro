---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageUrl = (path = "") => `${base}/${path}`;

// 나중에 이미지를 바꿀 때는 public/images 안의 같은 파일명만 덮어쓰면 됩니다.
const images = {
  hero: pageUrl("images/main-page.avif"),
  microscopy: pageUrl("images/research/brain-microscopy.webp"),
  lightSheet: pageUrl("images/research/surface-metrology.webp"),
};

const researchAreas = [
  { number: "01", title: "Biomedical Optics", text: "From OCT and imaging catheters to multimodal microscopy, we reveal tissue structure and biochemical information for biomedical research.", href: "research/biomedical-optics", image: images.microscopy, alt: "Two-photon light-sheet microscopy image of neural structures in a brain section" },
  { number: "02", title: "Optical Metrology", text: "We measure 3D surfaces, alignment, deformation, and material properties through precision optical imaging and spectroscopy.", href: "research/optical-metrology", image: images.lightSheet, alt: "Confocal measurements showing the shape and color of circuit-board and dental surfaces" },
];
---

<Layout title="BOOM Lab | Biomedical Optics & Optical Metrology" description="BOOM Lab develops biomedical optics and optical metrology technologies.">
  <section class="hero">
    <img class="hero-image" src={images.hero} alt="A sample being prepared beneath a microscope" />
    <div class="hero-shade"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow"><span></span> Biomedical Optics &amp; Optical Metrology Lab</p>
      <h1>Seeing the <em>unseen</em></h1>
      <div class="hero-actions">
        <a class="primary-button" href={pageUrl("research/biomedical-optics")}>Explore our research <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#about">Discover the lab <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="featured-video" aria-labelledby="featured-video-title">
    <div class="video-heading">
      <div>
        <h2 id="featured-video-title">BOOM Lab in motion</h2>
      </div>
    </div>
    <div class="video-frame">
      <iframe
        src="https://www.youtube-nocookie.com/embed/x6kmV8KAjc0?rel=0&playsinline=1"
        title="BOOM Lab featured video"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </section>

  <section class="about" id="about">
    <div class="about-copy">
      <h2>About Us</h2>
      <div class="about-detail">
        <p>The Biomedical Optics and Optical Metrology (BOOM) Lab develops optical imaging technologies to address medical problems and industrial challenges. We design new optical instruments and methods to reveal structures, processes, and material properties that are otherwise difficult to see.</p>
        <p>Our Biomedical Optics team develops OCT systems, imaging catheters, multimodal imaging systems, and advanced 3D microscopes, translating these technologies into preclinical and clinical research. By connecting tissue structure with biochemical information, we aim to support a deeper understanding of disease and more informed diagnosis and treatment. We also integrate AI to enhance optical images and support quantitative interpretation.</p>
        <p>Our Optical Metrology team develops confocal microscopy, interferometry, spectroscopy, and optical measurement methods for 3D surface imaging, precise alignment, deformation measurement, and material characterization. Across both areas, our goal is to advance medical diagnostics and precision industry applications by seeing the previously unseen.</p>
      </div>
    </div>
  </section>

  <section class="research-preview">
    <div class="research-heading">
      <div><p class="kicker">What we explore</p><h2>Research areas</h2></div>
      <a href={pageUrl("research/biomedical-optics")}>View all research <span aria-hidden="true">↗</span></a>
    </div>
    <div class="research-grid">
      {researchAreas.map((area) => (
        <article class="research-card">
          <a href={pageUrl(area.href)} aria-label={`Learn about ${area.title}`}>
            <div class:list={["card-image", { metrology: area.number === "02" }]}><img src={area.image} alt={area.alt} loading="lazy" /></div>
            <div class="card-body"><h3>{area.title}</h3><p>{area.text}</p><i aria-hidden="true">↗</i></div>
          </a>
        </article>
      ))}
    </div>
  </section>

</Layout>

<style>
  .hero { position: relative; min-height: 520px; height: clamp(520px, 42vw, 680px); overflow: hidden; display: flex; align-items: center; }
  .hero-image, .hero-shade, .hero-grid { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-image { object-fit: cover; object-position: center; transform: translateX(12%); mask-image: linear-gradient(90deg, transparent, black 12%); }
  .hero-shade { background: linear-gradient(90deg, rgba(4, 16, 28, 0.98) 0%, rgba(4, 16, 28, 0.82) 40%, rgba(4, 16, 28, 0.1) 78%); }
  .hero-grid { opacity: 0.12; background-image: linear-gradient(rgba(255,255,255,.2) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.2) 1px, transparent 1px); background-size: 80px 80px; mask-image: linear-gradient(90deg, black, transparent 70%); }
  .hero-content { position: relative; z-index: 2; width: var(--content); margin: 0 auto; padding: 80px 0 100px; }
  .eyebrow, .kicker { margin: 0; color: var(--acid); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: 12px; font-size: clamp(.95rem, 1.5vw, 1.3rem); line-height: 1.5; letter-spacing: .08em; }
  .eyebrow span { width: 28px; flex-shrink: 0; height: 1px; background: var(--acid); }
  h1 { max-width: 860px; margin: 30px 0 24px; font-size: clamp(4.2rem, 8.8vw, 8.1rem); line-height: 0.85; letter-spacing: -0.075em; }
  h1 em, h2 em { color: var(--cyan); font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  .hero-actions { display: flex; align-items: center; gap: 34px; margin-top: 42px; }
  .primary-button { min-width: 206px; padding: 16px 18px; display: flex; justify-content: space-between; align-items: center; border-radius: 2px; background: var(--acid); color: var(--ink); font-size: 0.82rem; font-weight: 700; transition: background 180ms ease, transform 180ms ease; }
  .primary-button:hover { background: var(--white); transform: translateY(-2px); }
  .text-link { padding-bottom: 5px; border-bottom: 1px solid var(--line); color: #e0e7eb; font-size: 0.82rem; }
  .text-link span { margin-left: 8px; color: var(--acid); }
  .about { width: var(--content); margin: 0 auto; padding: 100px 0 120px; display: block; }
  .about h2 { max-width: 950px; margin: 0 0 32px; font-size: clamp(2.7rem, 5.3vw, 5.6rem); line-height: 1.02; letter-spacing: -0.055em; }
  .about-detail { display: grid; gap: 24px; }
  .about-detail p { max-width: 900px; margin: 0; color: var(--muted); font-size: 1.18rem; line-height: 1.85; }
  .about-detail a, .research-heading > a { justify-self: end; padding-bottom: 6px; border-bottom: 1px solid var(--acid); font-size: 0.82rem; }
  .about-detail a span, .research-heading > a span { margin-left: 20px; color: var(--acid); }
  .featured-video { width: var(--content); margin: 0 auto; padding: 100px 0 0; }
  .video-heading { margin-bottom: 46px; }
  .video-heading h2 { margin: 15px 0 0; font-size: clamp(1.6rem, 6vw, 4.8rem); white-space: nowrap; line-height: 1; letter-spacing: -0.055em; }
  .video-frame { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border: 1px solid var(--line); background: #000; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.24); }
  .video-frame::before { content: ""; position: absolute; z-index: 1; inset: 0; pointer-events: none; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04); }
  .video-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .research-preview { padding: 120px max(32px, calc((100vw - 1280px) / 2)); background: var(--paper); color: var(--ink); }
  .research-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 58px; }
  .research-heading .kicker { color: #557074; }
  .research-heading h2 { margin: 14px 0 0; font-size: clamp(2.6rem, 4.5vw, 4.5rem); line-height: 1; letter-spacing: -0.055em; }
  .research-heading > a { border-color: #506469; }
  .research-heading > a span { color: #47686e; }
  .research-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .research-card { background: var(--white); }
  .card-image { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--ink-soft); }
  .card-image img { width: 100%; height: 100%; object-fit: contain; transition: transform 500ms ease; }
  .card-image.metrology { background: white; padding: 16px; }
  .research-card:hover .card-image img { transform: scale(1.035); }
  .card-body { position: relative; padding: 28px 72px 32px 28px; min-height: 176px; }
  .card-body h3 { margin: 0 0 12px; font-size: 1.45rem; letter-spacing: -0.03em; }
  .card-body p { max-width: 510px; margin: 0; color: #59666a; font-size: 0.9rem; line-height: 1.65; }
  .card-body i { position: absolute; top: 30px; right: 28px; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid #bdc6c4; border-radius: 50%; font-style: normal; }
  @media (max-width: 980px) {
    .hero { min-height: 520px; height: auto; }
    .about { grid-template-columns: 1fr; padding: 100px 0; }
    .video-heading { grid-template-columns: 1fr; gap: 24px; }
    .research-preview { padding-inline: 20px; }
  }
  @media (max-width: 700px) {
    .hero { min-height: 540px; }
    .hero-image { object-position: 62% center; }
    .hero-shade { background: linear-gradient(90deg, rgba(4,16,28,.98), rgba(4,16,28,.64)); }
    .hero-content { padding: 70px 0 120px; }
    h1 { font-size: clamp(3.65rem, 18vw, 5.8rem); }
    .hero-actions { align-items: flex-start; flex-direction: column; gap: 22px; }
    .about { padding: 80px 0; gap: 34px; }
    .about h2 { margin-bottom: 34px; }
    .about-detail { grid-template-columns: 1fr; gap: 32px; }
    .about-detail a { justify-self: start; }
    .featured-video { padding-top: 70px; }
    .video-heading { margin-bottom: 30px; }
    .research-preview { padding-block: 80px; }
    .research-heading { align-items: flex-start; flex-direction: column; }
    .research-heading > a { justify-self: start; }
    .research-grid { grid-template-columns: 1fr; }
  }
</style>
