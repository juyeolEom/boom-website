---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import news from "../data/news.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="News | BOOM Lab" description="Research updates and awards from BOOM Lab at KAIST.">
  <PageIntro title="News" eyebrow="From the lab" />
  <div class="news-shell" lang="ko">
    <ul class="news-list">
      {news.map((item) => (
        <li>
          <a class="news-link" href={`${base}/news/${item.slug}`}>
            <div class="thumbnail"><img src={`${base}/${item.thumbnail}`} alt={item.images[0].alt} width="800" height="600" loading="lazy" decoding="async" /></div>
            <div class="news-copy">
              <time datetime={item.date}>{item.date.replaceAll("-", ".")}</time>
              <h2>{item.title}</h2>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>

<style>
  .news-shell { background: var(--paper); color: var(--ink); padding: 28px max(32px, calc((100vw - 1120px) / 2)) 100px; }
  .news-list { list-style: none; padding: 0; margin: 0; }
  .news-list li + li { border-top: 1px solid #cbd5d2; }
  .news-link { display: grid; grid-template-columns: minmax(0, 380px) minmax(0, 1fr); align-items: center; gap: 48px; padding: 38px 0; }
  .thumbnail { aspect-ratio: 16 / 10; background: #e6ebe8; }
  .thumbnail img { width: 100%; height: 100%; object-fit: contain; }
  time { color: #52676b; font-size: .95rem; }
  h2 { font-size: clamp(1.3rem, 2.2vw, 1.8rem); line-height: 1.6; letter-spacing: -.025em; font-weight: 600; margin: 14px 0 0; word-break: keep-all; overflow-wrap: anywhere; }
  .news-link:hover h2 { text-decoration: underline; text-underline-offset: 6px; }
  .news-link:focus-visible { outline-color: #17617b; }
  @media (max-width: 760px) {
    .news-shell { padding: 10px 20px 60px; }
    .news-link { grid-template-columns: 1fr; gap: 22px; padding: 30px 0; }
  }
</style>
