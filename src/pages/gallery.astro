---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import albums from "../data/gallery.json";
import { albumDate } from "../lib/gallery";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const years = [...new Set(albums.map((album) => album.year))];
---

<Layout title="Gallery | BOOM Lab" description="Conferences, celebrations, and everyday moments at BOOM Lab.">
  <PageIntro title="Gallery" />
  <div class="gallery-index">
    {years.map((year) => (
      <section class="year-group" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`}>{year}</h2>
        <ul>
          {albums.filter((album) => album.year === year).map((album) => (
            <li id={`album-${album.slug}`}>
              <a href={`${base}/gallery/${album.slug}`}>
                <picture>
                  <source media="(max-width: 600px)" srcset="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E" />
                  <img src={`${base}/images/gallery/${album.thumbnail}`} alt="" width="112" height="76" loading="lazy" />
                </picture>
                <div class="entry">
                  <div class="meta"><time datetime={album.date}>{albumDate(album)}</time><span class="category">{album.category}</span></div>
                  <h3 lang="ko">{album.titleKo}</h3>
                  <p>{album.title}</p>
                </div>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>

<style>
  .gallery-index { background: var(--paper); color: var(--ink); padding: 48px max(24px, calc((100vw - 1280px) / 2)) 100px; }
  .year-group { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 40px; }
  .year-group + .year-group { margin-top: 64px; }
  h2 { margin: 16px 0; font-size: 2.3rem; letter-spacing: -.04em; }
  ul { list-style: none; padding: 0; margin: 0; border-top: 1px solid #bdc9c6; }
  li { border-bottom: 1px solid #cbd5d2; scroll-margin-top: 24px; }
  li a { display: grid; grid-template-columns: 112px minmax(0, 1fr) 24px; align-items: center; gap: 24px; padding: 16px 0; }
  picture, img { display: block; width: 112px; height: 76px; }
  img { object-fit: cover; border-radius: 2px; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; margin-bottom: 7px; color: #52676b; font-size: .78rem; }
  .category { color: #356775; border-left: 1px solid #afbfbb; padding-left: 16px; }
  h3 { margin: 0; font-size: 1.12rem; line-height: 1.5; font-weight: 600; word-break: keep-all; }
  .entry p { margin: 3px 0 0; font-size: .85rem; color: #52676b; line-height: 1.5; }
  .arrow { color: #326778; font-size: 1.25rem; }
  a:hover h3 { color: #17617b; text-decoration: underline; text-underline-offset: 4px; }
  a:focus-visible { outline: 2px solid #17617b; outline-offset: 4px; }
  @media (max-width: 900px) { .year-group { grid-template-columns: 1fr; gap: 12px; } }
  @media (max-width: 600px) {
    .gallery-index { padding: 28px 20px 64px; }
    h2 { font-size: 1.9rem; margin: 8px 0 12px; }
    .year-group + .year-group { margin-top: 40px; }
    li a { grid-template-columns: minmax(0, 1fr) 20px; gap: 16px; padding: 14px 0; }
    picture { display: none; }
    h3 { font-size: 1rem; }
    .entry p { font-size: .78rem; }
    .meta { font-size: .73rem; }
  }
</style>
