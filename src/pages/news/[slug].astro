---
import Layout from "../../layouts/Layout.astro";
import news from "../../data/news.json";

export function getStaticPaths() {
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={`${item.title} | BOOM Lab`} description={item.paragraphs[0]}>
  <div class="article-shell" lang="ko">
    <article>
      <a class="back-link" href={`${base}/news`}>← News 목록</a>
      <header class="article-heading">
        <time datetime={item.date}>{item.date.replaceAll("-", ".")}</time>
        <h1>{item.title}</h1>
      </header>
      <div class="article-images">
        {item.images.map((image, index) => (
          <figure>
            <img src={`${base}/${image.src}`} alt={image.alt} width={image.width} height={image.height} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          </figure>
        ))}
      </div>
      <div class="article-body">
        {item.paragraphs.map((paragraph) => <p lang={/^[A-Za-z]/.test(paragraph) ? "en" : "ko"}>{paragraph}</p>)}
      </div>
      {item.links.length > 0 && (
        <section class="related-links" aria-labelledby="related-title">
          <h2 id="related-title">관련 자료</h2>
          <ul>{item.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.type} · {link.label}</a></li>)}</ul>
        </section>
      )}
      <a class="back-link bottom-link" href={`${base}/news`}>← News 목록</a>
    </article>
  </div>
</Layout>

<style>
  .article-shell { background: var(--paper); color: var(--ink); padding: 48px max(32px, calc((100vw - 960px) / 2)) 100px; }
  .back-link, .related-links a { color: #17617b; text-decoration: underline; text-underline-offset: 4px; }
  .back-link { display: inline-block; padding: 8px 0; }
  .article-heading { margin: 40px 0; }
  time { color: #52676b; font-size: 1rem; }
  h1 { margin: 18px 0 0; font-size: clamp(1.7rem, 3.4vw, 2.8rem); line-height: 1.5; letter-spacing: -.03em; font-weight: 600; word-break: keep-all; overflow-wrap: anywhere; }
  .article-images { display: grid; gap: 28px; margin-bottom: 48px; }
  figure { margin: 0; }
  figure img { width: auto; max-width: 100%; height: auto; margin: 0 auto; }
  .article-body { max-width: 820px; margin: 0 auto; }
  .article-body p { margin: 0 0 26px; font-size: 1.1rem; line-height: 1.95; word-break: keep-all; overflow-wrap: anywhere; color: #354e54; }
  .related-links { margin: 42px 0 28px; padding-top: 26px; border-top: 1px solid #cbd5d2; }
  .related-links h2 { font-size: 1.1rem; margin: 0 0 16px; }
  .related-links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  a:focus-visible { outline-color: #17617b; }
  @media (max-width: 600px) {
    .article-shell { padding: 26px 20px 64px; }
    .article-heading { margin: 28px 0; }
    .article-body p { font-size: 1rem; }
  }
</style>
