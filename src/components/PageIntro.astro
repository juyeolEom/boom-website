---
const { eyebrow, title, description } = Astro.props;
---

<section class="page-intro">
  <div class="page-intro-inner">
    <p>{eyebrow}</p>
    <h1>{title}</h1>
    {description && <div class="description">{description}</div>}
  </div>
</section>

<style>
  .page-intro { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .page-intro::after { content: ""; position: absolute; width: 520px; height: 520px; right: -180px; bottom: -390px; border: 1px solid rgba(74, 230, 255, .22); border-radius: 50%; box-shadow: 0 0 120px rgba(74, 230, 255, .08); }
  .page-intro-inner { width: var(--content); margin: 0 auto; padding: 92px 0 84px; }
  p { margin: 0 0 18px; color: var(--acid); font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(3.6rem, 7vw, 7.2rem); line-height: .92; letter-spacing: -.065em; }
  .description { max-width: 640px; margin-top: 28px; color: var(--muted); font-size: 1.05rem; line-height: 1.75; }
  @media (max-width: 700px) {
    .page-intro-inner { padding: 68px 0 62px; }
    h1 { font-size: clamp(3.1rem, 17vw, 5rem); }
  }
</style>
