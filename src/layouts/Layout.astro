---
const {
  title = "BOOM Lab",
  description = "Biomedical Optics and Optical Metrology Laboratory",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageUrl = (path = "") => `${base}/${path}`;
const currentPath = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";

const navItems = [
  {
    label: "People",
    paths: ["/people"],
    children: [
      { label: "Professor", href: "people/professor" },
      { label: "Students", href: "people/students" },
      { label: "Alumni", href: "people/alumni" },
    ],
  },
  {
    label: "Research",
    paths: ["/research"],
    children: [
      { label: "Biomedical Optics", href: "research#biomedical-optics" },
      { label: "Optical Metrology", href: "research#optical-metrology" },
    ],
  },
  {
    label: "Publication",
    href: "publication",
    paths: ["/publication"],
  },
  { label: "Lecture", href: "lecture", paths: ["/lecture"] },
  { label: "Gallery", href: "gallery", paths: ["/gallery"] },
  { label: "News", href: "news", paths: ["/news"] },
].map((item) => ({
  ...item,
  active: item.paths.some((path) => currentPath.startsWith(path)),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={pageUrl("favicon.svg")} />
    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href={pageUrl()} aria-label="BOOM Lab home">
        <img class="brand-logo" src={pageUrl("images/boom-logo.png")} alt="BOOM Lab" />
      </a>

      <nav aria-label="Primary navigation">
        {
          navItems.map((item) => item.children ? (
            <div class="nav-group">
              <a href={pageUrl(item.children[0].href)} class:list={{ "nav-label": true, active: item.active }} aria-expanded="false" aria-controls={`nav-${item.label.toLowerCase()}`}>
                {item.label}
              </a>
              <div class="dropdown" id={`nav-${item.label.toLowerCase()}`}>
                {item.children.map((child) => (
                  <a href={pageUrl(child.href)}>{child.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={pageUrl(item.href)} aria-current={item.active ? "page" : undefined}>{item.label}</a>
          ))
        }
      </nav>

      <a class="contact-link" href="mailto:h.yoo@kaist.ac.kr">
        Contact
      </a>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div>
        <div class="footer-brand">
          <img src={pageUrl("images/boom-logo.png")} alt="BOOM Lab" />
        </div>
        <p>Biomedical Optics and Optical Metrology Laboratory</p>
      </div>
      <div class="footer-meta">
        <p>Department of Mechanical Engineering, KAIST</p>
        <p>Daejeon, Republic of Korea</p>
        <p>© {new Date().getFullYear()} BOOM Lab</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const groups = document.querySelectorAll<HTMLElement>(".nav-group");
  groups.forEach((group) => {
    const toggle = group.querySelector<HTMLAnchorElement>(".nav-label")!;
    const setOpen = (open: boolean) => toggle.setAttribute("aria-expanded", String(open));
    group.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse") setOpen(true);
    });
    group.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") setOpen(false);
    });
    group.addEventListener("focusout", (event) => {
      if (!group.contains(event.relatedTarget as Node)) setOpen(false);
    });
    group.querySelector(".nav-label")?.addEventListener("focus", (event) => {
      if ((event.target as HTMLElement).matches(":focus-visible")) setOpen(true);
    });
    group.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" && event.target === toggle) {
        event.preventDefault();
        setOpen(true);
        group.querySelector<HTMLAnchorElement>(".dropdown a")?.focus();
      }
      if (event.key === "Escape") {
        toggle.focus();
        setOpen(false);
      }
    });
    document.addEventListener("click", (event) => {
      if (!group.contains(event.target as Node)) setOpen(false);
    });
  });
</script>

<style is:global>
  :root {
    --ink: #04101c;
    --ink-soft: #0a1a2a;
    --paper: #f2f5f3;
    --white: #ffffff;
    --muted: #a8b4be;
    --line: rgba(255, 255, 255, 0.16);
    --acid: #8ed8ff;
    --cyan: #c2edff;
    --content: min(1280px, calc(100vw - 64px));
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--white);
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  .site-header {
    position: relative;
    z-index: 10;
    width: var(--content);
    height: 104px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 270px 1fr auto;
    align-items: center;
    gap: 28px;
    border-bottom: 1px solid var(--line);
  }
  .brand { display: block; width: max-content; }
  .brand-logo { width: 238px; height: auto; filter: invert(1) hue-rotate(180deg); }
  nav { display: flex; justify-content: center; align-items: center; gap: 36px; }
  nav > a, .nav-label { position: relative; color: #d9e1e6; font: inherit; font-size: 1rem; letter-spacing: 0.02em; white-space: nowrap; }
  nav > a, .nav-label { display: block; padding: 8px 0; }
  nav > a::after, .nav-label::after { content: ""; position: absolute; left: 0; bottom: -10px; width: 100%; height: 2px; background: var(--acid); transform: scaleX(0); transform-origin: right; transition: transform 180ms ease; }
  nav > a:hover::after, nav > a[aria-current="page"]::after, .nav-label:hover::after, .nav-label.active::after, .nav-group:has(:focus-visible) .nav-label::after { transform: scaleX(1); transform-origin: left; }
  .nav-group { position: relative; display: flex; align-items: center; }
  .nav-group::after { content: ""; position: absolute; top: 100%; left: -14px; width: calc(100% + 28px); height: 22px; }
  .dropdown { position: absolute; top: calc(100% + 10px); left: 0; min-width: 240px; padding: 9px; background: #0a1a2a; border: 1px solid var(--line); box-shadow: 0 18px 40px rgba(0,0,0,.28); opacity: 0; visibility: hidden; transition: opacity 160ms ease, visibility 160ms ease; }
  .nav-group:has(.nav-label[aria-expanded="true"]) .dropdown { opacity: 1; visibility: visible; }
  .dropdown a { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 11px 12px; color: #d9e1e6; font-size: .94rem; }
  .dropdown a:hover { background: rgba(255,255,255,.06); color: var(--acid); }
  .contact-link { min-width: 108px; display: flex; justify-content: center; align-items: center; padding: 11px 14px; border: 1px solid var(--line); border-radius: 99px; font-size: .94rem; transition: color 180ms ease, border-color 180ms ease; }
  .contact-link:hover { color: var(--acid); border-color: var(--acid); }
  .site-footer { width: var(--content); margin: 0 auto; padding: 68px 0 44px; display: flex; justify-content: space-between; gap: 32px; border-top: 1px solid var(--line); }
  .footer-brand { display: block; width: max-content; }
  .footer-brand img { width: 250px; height: auto; filter: invert(1) hue-rotate(180deg); }
  .site-footer p { margin: 10px 0 0; color: var(--muted); font-size: 0.8rem; }
  .footer-meta { text-align: right; }
  .footer-meta p { margin: 0 0 4px; }
  :focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
  @media (max-width: 1200px) {
    :root { --content: min(100% - 40px, 1280px); }
    .site-header { height: auto; min-height: 92px; grid-template-columns: 1fr auto; }
    .site-header nav { grid-column: 1 / -1; order: 3; justify-content: flex-start; flex-wrap: wrap; padding: 16px 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 640px) {
    :root { --content: min(100% - 28px, 1280px); }
    .site-header { min-height: 82px; gap: 14px; }
    .brand-logo { width: 170px; }
    .footer-brand img { width: 210px; }
    .contact-link { min-width: auto; gap: 10px; }
    #nav-research { left: 0; right: auto; }
    .dropdown { min-width: 210px; }
    .site-header nav { gap: 12px 28px; }
    .site-footer { flex-direction: column; padding-top: 48px; }
    .footer-meta { text-align: left; }
  }
  @media (pointer: coarse) {
    .dropdown { min-width: 210px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>
