---
const {
  title = "BOOM Lab",
  description = "Biomedical Optics and Optical Metrology Laboratory",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageUrl = (path = "") => `${base}/${path}`;
const currentPath = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";

const navItems = [
  { label: "Research", href: "research" },
  { label: "Professor", href: "people/professor" },
  { label: "Students", href: "people/students" },
  { label: "Alumni", href: "people/alumni" },
  { label: "Publications", href: "publication" },
  { label: "News", href: "news" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={pageUrl("favicon.svg")} />
    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <a class="brand" href={pageUrl()} aria-label="BOOM Lab home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>
          <strong>BOOM</strong>
          <small>Biomedical Optics &amp;<br />Optical Metrology Lab</small>
        </span>
      </a>

      <nav aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a
              href={pageUrl(item.href)}
              aria-current={currentPath === `/${item.href}` ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a class="contact-link" href="mailto:boomlab@example.edu">
        Contact <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div>
        <a class="footer-brand" href={pageUrl()}>BOOM <span>LAB</span></a>
        <p>Biomedical Optics and Optical Metrology Laboratory</p>
      </div>
      <div class="footer-meta">
        <p>Department / University Name</p>
        <p>City, Republic of Korea</p>
        <p>© {new Date().getFullYear()} BOOM Lab</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #04101c;
    --ink-soft: #0a1a2a;
    --paper: #f2f5f3;
    --white: #ffffff;
    --muted: #a8b4be;
    --line: rgba(255, 255, 255, 0.16);
    --acid: #c8ff2e;
    --cyan: #4ae6ff;
    --content: min(1280px, calc(100vw - 64px));
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--white);
    font-family: Inter, "Helvetica Neue", Arial, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; }
  .site-header {
    position: relative;
    z-index: 10;
    width: var(--content);
    height: 104px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 290px 1fr auto;
    align-items: center;
    gap: 28px;
    border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: center; gap: 13px; width: max-content; }
  .brand > span:last-child { display: flex; align-items: center; gap: 13px; }
  .brand strong { font-size: 1.35rem; line-height: 1; letter-spacing: -0.04em; }
  .brand small { color: var(--muted); font-size: 0.68rem; line-height: 1.15; letter-spacing: 0.04em; }
  .brand-mark { position: relative; width: 34px; height: 34px; display: block; border: 1px solid rgba(200, 255, 46, 0.5); border-radius: 50%; }
  .brand-mark i { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 10px var(--acid); }
  .brand-mark i:nth-child(1) { top: 7px; left: 14px; }
  .brand-mark i:nth-child(2) { top: 20px; left: 8px; }
  .brand-mark i:nth-child(3) { top: 19px; right: 7px; }
  nav { display: flex; justify-content: center; gap: clamp(18px, 2.4vw, 38px); }
  nav a { position: relative; color: #d9e1e6; font-size: 0.83rem; letter-spacing: 0.02em; }
  nav a::after { content: ""; position: absolute; left: 0; bottom: -10px; width: 100%; height: 2px; background: var(--acid); transform: scaleX(0); transform-origin: right; transition: transform 180ms ease; }
  nav a:hover::after, nav a[aria-current="page"]::after { transform: scaleX(1); transform-origin: left; }
  .contact-link { min-width: 108px; display: flex; justify-content: space-between; align-items: center; padding: 11px 14px; border: 1px solid var(--line); border-radius: 99px; font-size: 0.8rem; transition: color 180ms ease, border-color 180ms ease; }
  .contact-link:hover { color: var(--acid); border-color: var(--acid); }
  .site-footer { width: var(--content); margin: 0 auto; padding: 68px 0 44px; display: flex; justify-content: space-between; gap: 32px; border-top: 1px solid var(--line); }
  .footer-brand { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.05em; }
  .footer-brand span { color: var(--acid); }
  .site-footer p { margin: 10px 0 0; color: var(--muted); font-size: 0.8rem; }
  .footer-meta { text-align: right; }
  .footer-meta p { margin: 0 0 4px; }
  :focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
  @media (max-width: 980px) {
    :root { --content: min(100% - 40px, 1280px); }
    .site-header { height: auto; min-height: 92px; grid-template-columns: 1fr auto; }
    .site-header nav { grid-column: 1 / -1; order: 3; justify-content: flex-start; padding: 16px 0; overflow-x: auto; border-top: 1px solid var(--line); }
    .site-header nav a { white-space: nowrap; }
  }
  @media (max-width: 640px) {
    :root { --content: min(100% - 28px, 1280px); }
    .site-header { min-height: 82px; gap: 14px; }
    .brand small { display: none; }
    .contact-link { min-width: auto; gap: 10px; }
    .site-footer { flex-direction: column; padding-top: 48px; }
    .footer-meta { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>
